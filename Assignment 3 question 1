#include <stdio.h>
#include <stdlib.h>

void merge(int arr[], int l, int mid, int r)
{
    int m = mid - l + 1;
    int n = r - mid;

    int *L = (int*)malloc(m * sizeof(int));
    int *R = (int*)malloc(n * sizeof(int));

    // Copy data
    for (int i = 0; i < m; i++)
        L[i] = arr[l + i];

    for (int j = 0; j < n; j++)
        R[j] = arr[mid + 1 + j];

    int i = 0, j = 0, k = l;

    // Merge
    while (i < m && j < n)
    {
        if (L[i] <= R[j])
            arr[k++] = L[i++];
        else
            arr[k++] = R[j++];
    }

    // Remaining elements
    while (i < m)
        arr[k++] = L[i++];

    while (j < n)
        arr[k++] = R[j++];

    // Free memory
    free(L);
    free(R);
}

void mergesort(int arr[], int l, int r)
{
    if (l < r)
    {
        int mid = l + (r - l) / 2;

        mergesort(arr, l, mid);
        mergesort(arr, mid + 1, r);
        merge(arr, l, mid, r);
    }
}

int main()
{
    int n;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    int *arr = (int*)malloc(n * sizeof(int));

    printf("Enter elements:\n");
    for (int i = 0; i < n; i++)
        scanf("%d", &arr[i]);

    mergesort(arr, 0, n - 1);

    printf("Sorted array:\n");
    for (int i = 0; i < n; i++)
        printf("%d ", arr[i]);

    free(arr);

    return 0;
}
