#include <stdio.h>
#include <stdlib.h>

#define S 100

// Input function
int input_array(int arr[], int max_size)
{
    int len;
    printf("Enter number of elements (max %d): ", max_size);
    scanf("%d", &len);

    if (len > max_size) {
        printf("Size exceeds limit! Taking max size %d.\n", max_size);
        len = max_size;
    }

    printf("Enter elements (negative to stop):\n");

    int count = 0;
    for (int i = 0; i < len; i++)
    {
        int k;
        scanf("%d", &k);

        if (k < 0)
            break;

        arr[count++] = k;
    }

    return count;  // return actual length
}

// Reverse function
void reverse_array(int arr[], int len)
{
    for (int i = 0; i < len / 2; i++)
    {
        int temp = arr[i];
        arr[i] = arr[len - i - 1];
        arr[len - i - 1] = temp;
    }
}

// Duplicate check
int check_duplicate(const int arr[], int len)
{
    for (int i = 0; i < len - 1; i++)
    {
        for (int j = i + 1; j < len; j++)
        {
            if (arr[i] == arr[j])
                return 1; // duplicate found
        }
    }
    return 0; // no duplicate
}

int main()
{
    int array[S];
    int length;

    printf("Max size of array is %d\n", S);

    length = input_array(array, S);

    printf("\nElements of array are:\n");
    for (int i = 0; i < length; i++)
    {
        printf("%d ", array[i]);
    }

    reverse_array(array, length);

    printf("\n\nReversed array:\n");
    for (int i = 0; i < length; i++)
    {
        printf("%d ", array[i]);
    }

    if (check_duplicate(array, length))
        printf("\n\nDuplicate elements are present\n");
    else
        printf("\n\nNo duplicate elements\n");

    return 0;
}
