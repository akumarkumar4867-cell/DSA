#include <stdio.h>

// Binary Search
int Binary(int arr[], int n, int key)
{
    int low = 0, high = n - 1;

    while (low <= high)
    {
        int mid = (low + high) / 2;

        if (arr[mid] == key)
            return mid;
        else if (arr[mid] < key)
            low = mid + 1;
        else
            high = mid - 1;
    }
    return -1; // not found
}

// Insertion Sort
void insertion(int arr[], int n)
{
    for (int i = 1; i < n; ++i)   // start from 1
    {
        int key = arr[i];
        int j = i - 1;

        while (j >= 0 && arr[j] > key)
        {
            arr[j + 1] = arr[j];
            j--;
        }
        arr[j + 1] = key;
    }
}

int main()
{
    int arr[5] = {45, 56, 78, 98, 0};
    int n = sizeof(arr) / sizeof(arr[0]);

    insertion(arr, n);

    printf("Sorted array:\n");
    for (int i = 0; i < n; i++)
    {
        printf("%d ", arr[i]);
    }

    int key;
    printf("\nEnter element to search: ");
    scanf("%d", &key);

    int result = Binary(arr, n, key);

    if (result != -1)
        printf("Element found at index %d\n", result);
    else
        printf("Element not found\n");

    return 0;
}
